@model ECommerceApp.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow">
                <div class="card-body p-5">
                    <h3 class="fw-bold mb-2">Şifremi Unuttum</h3>
                    <p class="text-muted mb-4">E-posta adresinizi girin, şifre sıfırlama bağlantısı gönderelim.</p>
                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <input asp-for="Email" class="form-control" placeholder="E-posta adresiniz" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Bağlantı Gönder</button>
                        <a asp-action="Login" class="btn btn-outline-secondary w-100 mt-2">Geri Dön</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
