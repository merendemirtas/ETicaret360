@model IEnumerable<ECommerceApp.Models.Entities.Wishlist>
@{
    ViewData["Title"] = "Favorilerim";
}

<div class="container my-4">
    <h1 class="fw-bold mb-4">Favorilerim</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">Favori listeniz boş</h3>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Ürünleri Keşfet</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var product = item.Product;
                var mainImage = product?.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 product-card border-0 shadow-sm">
                        <div class="position-relative">
                            <a asp-controller="Product" asp-action="Detail" asp-route-slug="@product?.Slug">
                                <img src="@mainImage" class="card-img-top product-img" alt="@product?.Name"
                                     onerror="this.src='/images/no-image.png'" />
                            </a>
                        </div>
                        <div class="card-body p-3">
                            <small class="text-muted">@product?.Brand?.Name</small>
                            <h6 class="fw-semibold mt-1">@product?.Name</h6>
                            @if (product?.DiscountedPrice.HasValue == true)
                            {
                                <span class="text-muted text-decoration-line-through small">@product.Price.ToString("C2")</span>
                                <span class="fw-bold text-danger d-block">@product.DiscountedPrice.Value.ToString("C2")</span>
                            }
                            else
                            {
                                <span class="fw-bold">@product?.Price.ToString("C2")</span>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <form asp-action="MoveToCart" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product?.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-cart-plus me-1"></i>Sepete Taşı
                                    </button>
                                </form>
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product?.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
