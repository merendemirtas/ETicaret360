@model ECommerceApp.Models.ViewModels.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Ürün Düzenle";
    Layout = "_AdminLayout";
    ViewData["Breadcrumb"] = "Ürün Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post" action="/admin/urunler/duzenle/@Model.Id" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Ürün Adı</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShortDescription" class="form-label fw-semibold">Kısa Açıklama</label>
                        <input asp-for="ShortDescription" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">Fiyat (₺)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountedPrice" class="form-label fw-semibold">İndirimli Fiyat (₺)</label>
                            <input asp-for="DiscountedPrice" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold">Stok</label>
                            <input asp-for="Stock" class="form-control" type="number" />
                        </div>
                    </div>
                    @if (Model.ExistingImages.Any())
                    {
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Mevcut Görseller</label>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var img in Model.ExistingImages)
                                {
                                    <div class="position-relative">
                                        <img src="@img.ImageUrl" style="width:80px;height:80px;object-fit:cover;border-radius:8px"
                                             onerror="this.src='/images/no-image.png'" />
                                        @if (img.IsMain)
                                        {
                                            <span class="position-absolute top-0 start-0 badge bg-primary" style="font-size:.6rem">Ana</span>
                                        }
                                        <form asp-action="DeleteImage" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="imageId" value="@img.Id" />
                                            <input type="hidden" name="productId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm position-absolute top-0 end-0"
                                                    style="padding:1px 5px;font-size:.7rem"
                                                    onclick="return confirm('Görseli silmek istiyor musunuz?')">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="col-lg-4">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Kategori</label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label fw-semibold">Marka</label>
                        <select asp-for="BrandId" class="form-select"
                                asp-items="@(new SelectList(Model.Brands, "Id", "Name"))">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Yeni Görseller Ekle</label>
                        <input type="file" name="Images" class="form-control" multiple accept="image/*" />
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Aktif</label>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsFeatured" class="form-check-input" />
                            <label asp-for="IsFeatured" class="form-check-label">Öne Çıkan</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-2"></i>Güncelle
                    </button>
                    <a href="/admin/urunler" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
                </div>
            </div>
        </form>
    </div>
</div>
