@model ECommerceApp.Helpers.PaginatedList<ECommerceApp.Models.Entities.Product>
@{
    ViewData["Title"] = "Ürün Yönetimi";
    Layout = "_AdminLayout";
    ViewData["Breadcrumb"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Ürünler</h4>
    <a href="/admin/urunler/ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Yeni Ürün</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Ürün</th><th>Kategori</th><th>Fiyat</th><th>Stok</th><th>Durum</th><th>İşlemler</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    var img = p.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@img" style="width:45px;height:45px;object-fit:cover;border-radius:6px"
                                     onerror="this.src='/images/no-image.png'" />
                                <span class="fw-semibold small">@p.Name</span>
                            </div>
                        </td>
                        <td class="small">@p.Category?.Name</td>
                        <td class="small">
                            @if (p.DiscountedPrice.HasValue)
                            {
                                <span class="text-muted text-decoration-line-through">@p.Price.ToString("C2")</span>
                                <span class="text-danger d-block">@p.DiscountedPrice.Value.ToString("C2")</span>
                            }
                            else
                            {
                                @p.Price.ToString("C2")
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(p.Stock == 0 ? "danger" : p.Stock < 5 ? "warning" : "success")">@p.Stock</span>
                        </td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Aktif" : "Pasif")</span>
                            @if (p.IsFeatured) { <span class="badge bg-info ms-1">Öne Çıkan</span> }
                        </td>
                        <td>
                            <a href="/admin/urunler/duzenle/@p.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu ürünü pasif yapmak istediğinizden emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-archive"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    ViewBag.CurrentPage = Model.PageIndex;
    ViewBag.TotalPages = Model.TotalPages;
    ViewBag.PaginationController = "ProductMgmt";
}
<div class="mt-3">
    @await Html.PartialAsync("_Pagination")
</div>
