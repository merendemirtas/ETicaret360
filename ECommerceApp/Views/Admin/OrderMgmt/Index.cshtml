@model IEnumerable<ECommerceApp.Models.Entities.Order>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_AdminLayout";
    ViewData["Breadcrumb"] = "Siparişler";
}

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a href="/admin/siparisler" class="btn btn-sm @(ViewBag.CurrentStatus == null ? "btn-primary" : "btn-outline-secondary")">Tümü</a>
    @foreach (var status in Enum.GetValues<ECommerceApp.Models.Entities.OrderStatus>())
    {
        <a href="/admin/siparisler?durum=@((int)status)"
           class="btn btn-sm @(ViewBag.CurrentStatus != null && (ECommerceApp.Models.Entities.OrderStatus)ViewBag.CurrentStatus == status ? "btn-primary" : "btn-outline-secondary")">
            @status
        </a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Sipariş No</th><th>Müşteri</th><th>Tarih</th><th>Tutar</th><th>Durum</th><th>İşlem</th></tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">@order.OrderNumber</td>
                        <td>@order.User?.FullName</td>
                        <td>@order.OrderedAt.ToString("dd MMM yyyy")</td>
                        <td>@order.TotalAmount.ToString("C2")</td>
                        <td>
                            <span class="badge bg-@(order.Status == ECommerceApp.Models.Entities.OrderStatus.Delivered ? "success" : order.Status == ECommerceApp.Models.Entities.OrderStatus.Cancelled ? "danger" : "warning")">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            <a href="/admin/siparisler/detay/@order.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
