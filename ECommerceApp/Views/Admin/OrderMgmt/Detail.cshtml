@model ECommerceApp.Models.Entities.Order
@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/siparisler" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0">Sipariş: @Model.OrderNumber</h4>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-bold">Ürünler</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Ürün</th><th>Fiyat</th><th>Adet</th><th>Toplam</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@item.ProductImageUrl" style="width:45px;height:45px;object-fit:cover;border-radius:6px"
                                             onerror="this.src='/images/no-image.png'" />
                                        <span>@item.ProductName</span>
                                    </div>
                                </td>
                                <td>@item.UnitPrice.ToString("C2")</td>
                                <td>@item.Quantity</td>
                                <td>@item.TotalPrice.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="fw-bold">Durum Güncelle</h6>
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="status" class="form-select mb-2">
                        @foreach (var status in Enum.GetValues<ECommerceApp.Models.Entities.OrderStatus>())
                        {
                            <option value="@((int)status)" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Güncelle</button>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="fw-bold">Müşteri</h6>
                <p class="mb-1 small">@Model.User?.FullName</p>
                <p class="mb-0 small text-muted">@Model.User?.Email</p>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold">Özet</h6>
                <div class="d-flex justify-content-between small mb-1">
                    <span>Ara Toplam</span><span>@Model.SubTotal.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span>İndirim</span><span class="text-success">-@Model.DiscountAmount.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span>Kargo</span><span>@(Model.ShippingCost == 0 ? "Ücretsiz" : Model.ShippingCost.ToString("C2"))</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fw-bold">
                    <span>Toplam</span><span>@Model.TotalAmount.ToString("C2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
