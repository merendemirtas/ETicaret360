@model IEnumerable<ECommerceApp.Models.Entities.Brand>
@{
    ViewData["Title"] = "Marka Yönetimi";
    Layout = "_AdminLayout";
    ViewData["Breadcrumb"] = "Markalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Markalar</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Yeni Marka</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Logo</th><th>Ad</th><th>Durum</th><th>İşlem</th></tr>
            </thead>
            <tbody>
                @foreach (var brand in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <img src="@brand.LogoUrl" style="height:40px;object-fit:contain" onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="fw-semibold align-middle">@brand.Name</td>
                        <td class="align-middle"><span class="badge @(brand.IsActive ? "bg-success" : "bg-secondary")">@(brand.IsActive ? "Aktif" : "Pasif")</span></td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@brand.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Markayı pasif yapmak istiyor musunuz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-archive"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
