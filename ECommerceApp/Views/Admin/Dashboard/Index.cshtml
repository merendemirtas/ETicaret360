@model ECommerceApp.Models.ViewModels.DashboardViewModel
@using ECommerceApp.Models.Entities
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";

    string StatusClass(OrderStatus s) => s switch {
        OrderStatus.Pending   => "et-status-pending",
        OrderStatus.Confirmed => "et-status-confirmed",
        OrderStatus.Preparing => "et-status-preparing",
        OrderStatus.Shipped   => "et-status-shipped",
        OrderStatus.Delivered => "et-status-delivered",
        OrderStatus.Cancelled => "et-status-cancelled",
        _                     => "et-status-pending"
    };
    string StatusLabel(OrderStatus s) => s switch {
        OrderStatus.Pending   => "Bekliyor",
        OrderStatus.Confirmed => "Onaylandı",
        OrderStatus.Preparing => "Hazırlanıyor",
        OrderStatus.Shipped   => "Kargoda",
        OrderStatus.Delivered => "Teslim Edildi",
        OrderStatus.Cancelled => "İptal",
        _                     => s.ToString()
    };

    var maxSales = Model.MonthlyStats.Any() ? Model.MonthlyStats.Max(m => m.Sales) : 1;
    var maxOrders = Model.MonthlyStats.Any() ? Model.MonthlyStats.Max(m => m.Orders) : 1;
}

<!-- Hoş Geldin -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem">
    <div>
        <h4 style="font-size:1.3rem;font-weight:800;margin:0">Genel Bakış</h4>
        <div style="font-size:.85rem;color:var(--text-muted);margin-top:.2rem">
            <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMMM yyyy, dddd")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/urunler/ekle" class="et-btn et-btn-primary" style="height:38px;font-size:.85rem">
            <i class="bi bi-plus-lg me-1"></i>Yeni Ürün
        </a>
        <a href="/admin/siparisler" class="et-btn et-btn-outline" style="height:38px;font-size:.85rem">
            <i class="bi bi-receipt me-1"></i>Siparişler
        </a>
    </div>
</div>

<!-- ── Ana Stat Kartları ── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="et-stat-card">
            <div class="et-stat-icon" style="background:#ede9fe">
                <i class="bi bi-currency-dollar" style="color:#7c3aed"></i>
            </div>
            <div>
                <div class="et-stat-value" style="color:#7c3aed">@Model.TotalSales.ToString("N0") ₺</div>
                <div class="et-stat-label">Toplam Satış</div>
                @if (Model.TodaySales > 0)
                {
                    <div style="font-size:.72rem;color:#059669;margin-top:.2rem">
                        <i class="bi bi-arrow-up me-1"></i>Bugün: @Model.TodaySales.ToString("N0") ₺
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="et-stat-card">
            <div class="et-stat-icon" style="background:#d1fae5">
                <i class="bi bi-bag-check" style="color:#059669"></i>
            </div>
            <div>
                <div class="et-stat-value" style="color:#059669">@Model.TotalOrders</div>
                <div class="et-stat-label">Toplam Sipariş</div>
                @if (Model.TodayOrders > 0)
                {
                    <div style="font-size:.72rem;color:#059669;margin-top:.2rem">
                        <i class="bi bi-clock me-1"></i>Bugün: @Model.TodayOrders yeni
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="et-stat-card">
            <div class="et-stat-icon" style="background:#dbeafe">
                <i class="bi bi-box-seam" style="color:#2563eb"></i>
            </div>
            <div>
                <div class="et-stat-value" style="color:#2563eb">@Model.TotalProducts</div>
                <div class="et-stat-label">Aktif Ürün</div>
                @if (Model.LowStockProducts.Any())
                {
                    <div style="font-size:.72rem;color:#dc2626;margin-top:.2rem">
                        <i class="bi bi-exclamation-triangle me-1"></i>@Model.LowStockProducts.Count() düşük stok
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="et-stat-card">
            <div class="et-stat-icon" style="background:#fef3c7">
                <i class="bi bi-people" style="color:#d97706"></i>
            </div>
            <div>
                <div class="et-stat-value" style="color:#d97706">@Model.TotalUsers</div>
                <div class="et-stat-label">Toplam Kullanıcı</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Sipariş Durumu Kartları ── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;display:flex;align-items:center;gap:.75rem">
            <div style="width:10px;height:36px;background:#f59e0b;border-radius:4px;flex-shrink:0"></div>
            <div>
                <div style="font-size:1.3rem;font-weight:800">@Model.PendingOrders</div>
                <div style="font-size:.78rem;color:var(--text-muted)">Bekleyen</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;display:flex;align-items:center;gap:.75rem">
            <div style="width:10px;height:36px;background:#6366f1;border-radius:4px;flex-shrink:0"></div>
            <div>
                <div style="font-size:1.3rem;font-weight:800">@Model.ShippedOrders</div>
                <div style="font-size:.78rem;color:var(--text-muted)">Kargoda</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;display:flex;align-items:center;gap:.75rem">
            <div style="width:10px;height:36px;background:#10b981;border-radius:4px;flex-shrink:0"></div>
            <div>
                <div style="font-size:1.3rem;font-weight:800">@Model.DeliveredOrders</div>
                <div style="font-size:.78rem;color:var(--text-muted)">Teslim Edildi</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;display:flex;align-items:center;gap:.75rem">
            <div style="width:10px;height:36px;background:#ef4444;border-radius:4px;flex-shrink:0"></div>
            <div>
                <div style="font-size:1.3rem;font-weight:800">@Model.CancelledOrders</div>
                <div style="font-size:.78rem;color:var(--text-muted)">İptal</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- ── Sol: Grafik + Sipariş Tablosu ── -->
    <div class="col-lg-8">

        <!-- Satış Grafiği (CSS bar chart) -->
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;margin-bottom:1.5rem">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
                <div>
                    <div style="font-weight:700;font-size:1rem">Aylık Satış Trendi</div>
                    <div style="font-size:.8rem;color:var(--text-muted)">Son 6 ay</div>
                </div>
                <div style="display:flex;gap:1rem;font-size:.78rem">
                    <span style="display:flex;align-items:center;gap:.3rem">
                        <span style="width:10px;height:10px;background:var(--primary);border-radius:2px;display:inline-block"></span>Satış
                    </span>
                    <span style="display:flex;align-items:center;gap:.3rem">
                        <span style="width:10px;height:10px;background:#10b981;border-radius:2px;display:inline-block"></span>Sipariş
                    </span>
                </div>
            </div>

            <!-- Bar chart -->
            <div style="display:flex;gap:8px;align-items:flex-end;height:160px">
                @foreach (var stat in Model.MonthlyStats)
                {
                    var salesH = maxSales > 0 ? (int)(stat.Sales / maxSales * 140) : 4;
                    var ordersH = maxOrders > 0 ? (int)((double)stat.Orders / maxOrders * 140) : 4;
                    <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px">
                        <div style="width:100%;display:flex;gap:2px;align-items:flex-end;height:140px">
                            <div style="flex:1;background:var(--primary);border-radius:4px 4px 0 0;height:@(Math.Max(salesH,4))px;transition:height .5s ease;cursor:pointer"
                                 title="Satış: @stat.Sales.ToString("N0") ₺"></div>
                            <div style="flex:1;background:#10b981;border-radius:4px 4px 0 0;height:@(Math.Max(ordersH,4))px;transition:height .5s ease;cursor:pointer"
                                 title="Sipariş: @stat.Orders adet"></div>
                        </div>
                        <div style="font-size:.72rem;color:var(--text-muted);font-weight:600">@stat.Month</div>
                    </div>
                }
            </div>

            <!-- Y ekseni etiketleri -->
            <div style="display:flex;justify-content:space-between;margin-top:.75rem;font-size:.75rem;color:var(--text-muted);border-top:1px solid var(--border);padding-top:.75rem">
                @foreach (var stat in Model.MonthlyStats)
                {
                    <div style="flex:1;text-align:center">
                        <div style="font-weight:700;color:var(--text)">@stat.Sales.ToString("N0")</div>
                        <div>@stat.Orders sip.</div>
                    </div>
                }
            </div>
        </div>

        <!-- Son Siparişler -->
        <div class="et-table">
            <div style="padding:1rem 1.25rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)">
                <div style="font-weight:700;font-size:.95rem">Son Siparişler</div>
                <a href="/admin/siparisler" style="font-size:.82rem;color:var(--primary);text-decoration:none;font-weight:600">
                    Tümünü Gör <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><span style="font-family:monospace;font-size:.82rem;font-weight:600">@o.OrderNumber</span></td>
                            <td>
                                <div style="font-weight:600;font-size:.88rem">@(o.User?.FullName ?? "—")</div>
                                <div style="font-size:.76rem;color:var(--text-muted)">@o.User?.Email</div>
                            </td>
                            <td style="font-weight:700">@o.TotalAmount.ToString("N0") ₺</td>
                            <td><span class="et-status @StatusClass(o.Status)">@StatusLabel(o.Status)</span></td>
                            <td style="font-size:.8rem;color:var(--text-muted)">@o.OrderedAt.ToString("dd MMM HH:mm")</td>
                            <td>
                                <a href="/admin/siparisler/detay/@o.Id"
                                   style="font-size:.8rem;color:var(--primary);font-weight:600;text-decoration:none">
                                    Detay →
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted)">Henüz sipariş yok</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── Sağ: Hızlı Erişim + Stok Uyarısı ── -->
    <div class="col-lg-4">

        <!-- Hızlı Erişim -->
        <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;margin-bottom:1.5rem">
            <div style="font-weight:700;font-size:.95rem;margin-bottom:1rem">Hızlı Erişim</div>
            <div style="display:flex;flex-direction:column;gap:.5rem">
                @{
                    var links = new[] {
                        ("/admin/urunler/ekle",    "bi-plus-circle",    "Yeni Ürün Ekle",      "#ede9fe","#7c3aed"),
                        ("/admin/kategoriler",     "bi-tags",           "Kategori Yönetimi",   "#dbeafe","#2563eb"),
                        ("/admin/markalar",        "bi-award",          "Marka Yönetimi",      "#d1fae5","#059669"),
                        ("/admin/siparisler",      "bi-receipt",        "Siparişleri Gör",     "#fef3c7","#d97706"),
                        ("/admin/kuponlar",        "bi-ticket-perforated","Kupon Ekle",         "#fce7f3","#db2777"),
                        ("/admin/yorumlar",        "bi-chat-square-text","Yorumları Onayla",   "#f0fdf4","#16a34a"),
                    };
                    foreach (var (url, icon, label, bg, color) in links)
                    {
                        <a href="@url" style="display:flex;align-items:center;gap:.75rem;padding:.7rem .9rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);transition:all .2s"
                           onmouseover="this.style.borderColor='@color';this.style.background='@bg'"
                           onmouseout="this.style.borderColor='var(--border)';this.style.background='transparent'">
                            <div style="width:32px;height:32px;background:@bg;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi @icon" style="color:@color"></i>
                            </div>
                            <span style="font-size:.88rem;font-weight:600">@label</span>
                            <i class="bi bi-chevron-right ms-auto" style="font-size:.75rem;color:var(--text-muted)"></i>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Stok Uyarısı -->
        @if (Model.LowStockProducts.Any())
        {
            <div style="background:#fff;border:1px solid #fca5a5;border-radius:var(--radius);overflow:hidden">
                <div style="padding:1rem 1.25rem;background:#fff1f2;border-bottom:1px solid #fca5a5;display:flex;align-items:center;gap:.5rem">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626"></i>
                    <span style="font-weight:700;font-size:.9rem;color:#dc2626">Düşük Stok Uyarısı</span>
                    <span style="margin-left:auto;background:#dc2626;color:#fff;border-radius:100px;padding:.1rem .5rem;font-size:.72rem;font-weight:700">
                        @Model.LowStockProducts.Count()
                    </span>
                </div>
                <div style="max-height:280px;overflow-y:auto">
                    @foreach (var p in Model.LowStockProducts)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem 1.25rem;border-bottom:1px solid var(--border)">
                            <div>
                                <div style="font-size:.86rem;font-weight:600">@p.Name</div>
                                <a href="/admin/urunler/duzenle/@p.Id"
                                   style="font-size:.75rem;color:var(--primary);text-decoration:none">Düzenle →</a>
                            </div>
                            <span style="background:@(p.Stock == 0 ? "#fee2e2" : "#fef3c7");color:@(p.Stock == 0 ? "#dc2626" : "#d97706");padding:.2rem .6rem;border-radius:100px;font-size:.75rem;font-weight:700;flex-shrink:0">
                                @(p.Stock == 0 ? "Tükendi" : p.Stock + " adet")
                            </span>
                        </div>
                    }
                </div>
                <div style="padding:.75rem 1.25rem;background:#fff1f2">
                    <a href="/admin/urunler" style="font-size:.82rem;color:#dc2626;font-weight:600;text-decoration:none">
                        Tüm ürünleri gör →
                    </a>
                </div>
            </div>
        }
        else
        {
            <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;text-align:center">
                <div style="width:48px;height:48px;background:#d1fae5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto .75rem;font-size:1.3rem">
                    <i class="bi bi-check-circle-fill" style="color:#059669"></i>
                </div>
                <div style="font-weight:700;font-size:.9rem">Stok Durumu İyi</div>
                <div style="font-size:.82rem;color:var(--text-muted);margin-top:.3rem">Düşük stoklu ürün yok</div>
            </div>
        }
    </div>
</div>
