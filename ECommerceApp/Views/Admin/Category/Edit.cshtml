@model ECommerceApp.Models.Entities.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-4">Kategori Düzenle</h5>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Kategori Adı</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ParentId" class="form-label fw-semibold">Üst Kategori</label>
                    <select asp-for="ParentId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.ParentCategories as IEnumerable<ECommerceApp.Models.Entities.Category>, "Id", "Name"))">
                        <option value="">Yok (Ana Kategori)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold">Sıra</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" />
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Aktif</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Güncelle</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">İptal</a>
            </div>
        </form>
    </div>
</div>
