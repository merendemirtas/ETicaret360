@model IEnumerable<ECommerceApp.Models.Entities.Review>
@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "_AdminLayout";
    ViewData["Breadcrumb"] = "Yorumlar";
}

<h4 class="fw-bold mb-4">Onay Bekleyen Yorumlar</h4>

@if (!Model.Any())
{
    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>Onay bekleyen yorum yok.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Ürün</th><th>Kullanıcı</th><th>Puan</th><th>Yorum</th><th>Tarih</th><th>İşlemler</th></tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td class="small">@review.Product?.Name</td>
                            <td class="small">@review.User?.FullName</td>
                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star") small"></i>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(review.Title)) { <strong>@review.Title</strong><br /> }
                                @review.Comment
                            </td>
                            <td class="small">@review.CreatedAt.ToString("dd MMM")</td>
                            <td>
                                <form asp-action="Approve" asp-route-id="@review.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success me-1" title="Onayla">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu yorumu silmek istiyor musunuz?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
