@model ECommerceApp.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var categoryIcons = new Dictionary<string, string> {
        {"elektronik","bi-cpu"}, {"giyim","bi-bag"}, {"kitap","bi-book"},
        {"spor","bi-trophy"}, {"ev","bi-house"}, {"default","bi-grid"}
    };
}

<!-- ══ HERO ══ -->
<div class="container-fluid px-3 px-lg-4">
    <div class="et-hero mt-2">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-up">
                <div class="et-hero-tag">
                    <i class="bi bi-stars"></i>Türkiye'nin Yeni Nesil Alışveriş Platformu
                </div>
                <h1 class="mb-4">
                    <span class="gradient-text">Binlerce ürün,</span><br>
                    tek bir adreste.
                </h1>
                <p class="mb-4">
                    Elektronikten giyime, sporden eve — ihtiyacın olan her şeyi en iyi fiyatlarla bul.
                    Hızlı teslimat, kolay iade garantisi.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/urunler" class="et-btn et-btn-primary" style="height:48px;padding:0 1.8rem">
                        <i class="bi bi-grid-fill me-1"></i>Alışverişe Başla
                    </a>
                    <a href="/urunler?indirimli=true" class="et-btn et-btn-outline" style="height:48px;padding:0 1.8rem">
                        <i class="bi bi-tag me-1"></i>İndirimler
                    </a>
                </div>
                <div class="d-flex gap-4 mt-4 pt-2" style="border-top:1px solid rgba(99,102,241,.15)">
                    <div>
                        <div style="font-size:1.4rem;font-weight:800;color:var(--primary)">10K+</div>
                        <div style="font-size:.8rem;color:var(--text-muted)">Ürün</div>
                    </div>
                    <div>
                        <div style="font-size:1.4rem;font-weight:800;color:var(--primary)">500+</div>
                        <div style="font-size:.8rem;color:var(--text-muted)">Marka</div>
                    </div>
                    <div>
                        <div style="font-size:1.4rem;font-weight:800;color:var(--primary)">50K+</div>
                        <div style="font-size:.8rem;color:var(--text-muted)">Mutlu Müşteri</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-end align-items-center pe-3">
                <div style="position:relative;width:420px;height:320px">
                    <div style="position:absolute;top:0;right:0;width:280px;height:280px;background:rgba(99,102,241,.1);border-radius:50%"></div>
                    <div style="position:absolute;bottom:0;left:0;width:180px;height:180px;background:rgba(245,158,11,.1);border-radius:50%"></div>
                    <div style="position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1rem">
                        @if (Model?.FeaturedProducts?.Any() == true)
                        {
                            @foreach (var p in Model.FeaturedProducts.Take(4))
                            {
                                var img = p.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
                                <div style="background:#fff;border-radius:16px;padding:.75rem;box-shadow:0 4px 16px rgba(0,0,0,.08);text-align:center">
                                    <img src="@img" alt="@p.Name" style="width:80px;height:80px;object-fit:cover;border-radius:10px">
                                    <div style="font-size:.75rem;font-weight:600;margin-top:.5rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Name</div>
                                    <div style="font-size:.8rem;color:var(--primary);font-weight:700">@((p.DiscountedPrice ?? p.Price).ToString("N0")) ₺</div>
                                </div>
                            }
                        }
                        else
                        {
                            for (int i = 0; i < 4; i++)
                            {
                                <div style="background:#fff;border-radius:16px;padding:.75rem;box-shadow:0 4px 16px rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;height:110px">
                                    <i class="bi bi-box-seam" style="font-size:2rem;color:var(--primary-muted)"></i>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ PROMO BANNER ══ -->
<div class="container-fluid px-3 px-lg-4 mt-3">
    <div class="row g-3">
        <div class="col-md-4">
            <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;display:flex;align-items:center;gap:1rem">
                <div style="width:48px;height:48px;background:#d1fae5;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="bi bi-truck" style="color:#059669;font-size:1.3rem"></i>
                </div>
                <div>
                    <div style="font-weight:700;font-size:.95rem">Ücretsiz Kargo</div>
                    <div style="font-size:.8rem;color:var(--text-muted)">300₺ üzeri siparişlerde</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;display:flex;align-items:center;gap:1rem">
                <div style="width:48px;height:48px;background:#dbeafe;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="bi bi-arrow-repeat" style="color:#2563eb;font-size:1.3rem"></i>
                </div>
                <div>
                    <div style="font-weight:700;font-size:.95rem">Kolay İade</div>
                    <div style="font-size:.8rem;color:var(--text-muted)">14 gün içinde sorunsuz iade</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;display:flex;align-items:center;gap:1rem">
                <div style="width:48px;height:48px;background:#ede9fe;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="bi bi-shield-check" style="color:#7c3aed;font-size:1.3rem"></i>
                </div>
                <div>
                    <div style="font-weight:700;font-size:.95rem">Güvenli Ödeme</div>
                    <div style="font-size:.8rem;color:var(--text-muted)">SSL ile şifreli alışveriş</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ KATEGORİLER ══ -->
@if (Model?.MainCategories?.Any() == true)
{
    <div class="container-fluid px-3 px-lg-4 mt-5">
        <div class="et-section-header">
            <div>
                <div class="et-section-label"><i class="bi bi-grid me-1"></i>Kategoriler</div>
                <h2 class="et-section-title">Ne arıyorsun?</h2>
            </div>
            <a href="/urunler" class="et-btn et-btn-outline" style="height:40px">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.MainCategories)
            {
                var iconKey = cat.Slug?.Split('-')[0] ?? "default";
                var icon = categoryIcons.ContainsKey(iconKey) ? categoryIcons[iconKey] : "bi-grid";
                <div class="col-6 col-md-4 col-lg-2 fade-up fade-up-1">
                    <a href="/urunler?kategori=@cat.Slug" class="et-cat-card">
                        <div class="et-cat-icon"><i class="bi @icon"></i></div>
                        <span class="et-cat-name">@cat.Name</span>
                        <span class="et-cat-count">@(cat.Products?.Count ?? 0) ürün</span>
                    </a>
                </div>
            }
        </div>
    </div>
}

<!-- ══ ÖNE ÇIKAN ÜRÜNLER ══ -->
@if (Model?.FeaturedProducts?.Any() == true)
{
    <div class="container-fluid px-3 px-lg-4 mt-5">
        <div class="et-section-header">
            <div>
                <div class="et-section-label"><i class="bi bi-stars me-1"></i>Öne Çıkan</div>
                <h2 class="et-section-title">Popüler Ürünler</h2>
            </div>
            <a href="/urunler?siralama=featured" class="et-btn et-btn-outline" style="height:40px">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var p in Model.FeaturedProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ProductCard", p)
                </div>
            }
        </div>
    </div>
}

<!-- ══ PROMO ══ -->
<div class="container-fluid px-3 px-lg-4 mt-5">
    <div class="et-promo">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div style="font-size:.85rem;font-weight:600;opacity:.7;margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.08em">Özel Fırsat</div>
                <h2 style="font-size:clamp(1.5rem,4vw,2.5rem);font-weight:800;margin-bottom:.75rem;color:#fff">
                    İlk siparişinde %10 indirim!
                </h2>
                <p style="opacity:.85;max-width:480px;line-height:1.7;margin-bottom:1.5rem">
                    Kayıt ol, <strong>HOSGELDIN10</strong> kupon kodunu kullan, ilk alışverişinde anında indirim kazan.
                </p>
                <a href="/account/register" class="et-btn" style="background:#fff;color:var(--primary);height:48px;padding:0 2rem;font-weight:700">
                    Hemen Kayıt Ol <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ══ YENİ ÜRÜNLER ══ -->
@if (Model?.NewArrivals?.Any() == true)
{
    <div class="container-fluid px-3 px-lg-4 mt-5">
        <div class="et-section-header">
            <div>
                <div class="et-section-label"><i class="bi bi-lightning me-1"></i>Yeni</div>
                <h2 class="et-section-title">Son Eklenenler</h2>
            </div>
            <a href="/urunler?siralama=new" class="et-btn et-btn-outline" style="height:40px">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var p in Model.NewArrivals)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ProductCard", p)
                </div>
            }
        </div>
    </div>
}

<!-- ══ İNDİRİMLİ ÜRÜNLER ══ -->
@if (Model?.DiscountedProducts?.Any() == true)
{
    <div class="container-fluid px-3 px-lg-4 mt-5 mb-5">
        <div class="et-section-header">
            <div>
                <div class="et-section-label" style="background:#fef3c7;color:#d97706"><i class="bi bi-tag-fill me-1"></i>İndirim</div>
                <h2 class="et-section-title">Fırsatları Kaçırma</h2>
            </div>
            <a href="/urunler?indirimli=true" class="et-btn et-btn-outline" style="height:40px">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var p in Model.DiscountedProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ProductCard", p)
                </div>
            }
        </div>
    </div>
}

<div style="height:2rem"></div>
