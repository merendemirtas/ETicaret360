@model ECommerceApp.Models.Entities.Order
@{
    ViewData["Title"] = "Siparişiniz Alındı!";
}

<div class="container-fluid px-3 px-lg-4 py-5">
    <div style="max-width:600px;margin:0 auto;text-align:center">

        <!-- Başarı ikonu -->
        <div style="width:80px;height:80px;background:#d1fae5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:2.5rem">
            <i class="bi bi-check-lg" style="color:#059669"></i>
        </div>

        <div class="et-section-label justify-content-center mb-2" style="display:inline-flex">
            <i class="bi bi-bag-check me-1"></i>Sipariş Onaylandı
        </div>
        <h1 style="font-size:2rem;font-weight:800;margin-bottom:.75rem">Teşekkürler!</h1>
        <p style="color:var(--text-muted);font-size:1.05rem;line-height:1.7;margin-bottom:2rem">
            Siparişiniz başarıyla alındı. Siparişiniz hazırlandıktan sonra kargoya verilecektir.
        </p>

        <!-- Sipariş no -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;margin-bottom:1.5rem;text-align:left">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid var(--border)">
                <span style="font-weight:700">Sipariş No</span>
                <span style="font-family:monospace;background:var(--primary-muted);color:var(--primary);padding:.3rem .8rem;border-radius:var(--radius-sm);font-weight:700">
                    @Model.OrderNumber
                </span>
            </div>

            @foreach (var item in Model.Items)
            {
                <div style="display:flex;justify-content:space-between;font-size:.9rem;margin-bottom:.5rem">
                    <span>@item.ProductName <span style="color:var(--text-muted)">×@item.Quantity</span></span>
                    <span style="font-weight:600">@item.TotalPrice.ToString("N0") ₺</span>
                </div>
            }

            <div style="border-top:1px solid var(--border);margin-top:1rem;padding-top:1rem;display:flex;justify-content:space-between;font-weight:700;font-size:1.05rem">
                <span>Toplam</span>
                <span style="color:var(--primary)">@Model.TotalAmount.ToString("N0") ₺</span>
            </div>

            <div style="margin-top:1rem;padding:1rem;background:var(--surface-2);border-radius:var(--radius-sm);font-size:.88rem;color:var(--text-muted)">
                <div><i class="bi bi-geo-alt me-1 text-primary"></i>
                    @Model.Address?.FullAddress, @Model.Address?.District / @Model.Address?.City
                </div>
                <div class="mt-1"><i class="bi bi-cash-coin me-1 text-success"></i>Ödeme: Kapıda Ödeme</div>
            </div>
        </div>

        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/siparis/siparislerim" class="et-btn et-btn-primary" style="height:46px;padding:0 1.8rem">
                <i class="bi bi-box-seam me-1"></i>Siparişlerim
            </a>
            <a href="/urunler" class="et-btn et-btn-outline" style="height:46px;padding:0 1.8rem">
                <i class="bi bi-arrow-left me-1"></i>Alışverişe Devam Et
            </a>
        </div>
    </div>
</div>
