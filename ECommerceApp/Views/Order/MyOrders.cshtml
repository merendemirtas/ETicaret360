@model IEnumerable<ECommerceApp.Models.Entities.Order>
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container my-4">
    <h1 class="fw-bold mb-4">Siparişlerim</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">Henüz siparişiniz yok</h3>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Alışverişe Başla</a>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            var statusText = order.Status switch
            {
                ECommerceApp.Models.Entities.OrderStatus.Pending => "Beklemede",
                ECommerceApp.Models.Entities.OrderStatus.Confirmed => "Onaylandı",
                ECommerceApp.Models.Entities.OrderStatus.Preparing => "Hazırlanıyor",
                ECommerceApp.Models.Entities.OrderStatus.Shipped => "Kargoya Verildi",
                ECommerceApp.Models.Entities.OrderStatus.Delivered => "Teslim Edildi",
                ECommerceApp.Models.Entities.OrderStatus.Cancelled => "İptal Edildi",
                ECommerceApp.Models.Entities.OrderStatus.Refunded => "İade Edildi",
                _ => "Bilinmiyor"
            };
            var statusClass = order.Status switch
            {
                ECommerceApp.Models.Entities.OrderStatus.Delivered => "success",
                ECommerceApp.Models.Entities.OrderStatus.Cancelled => "danger",
                ECommerceApp.Models.Entities.OrderStatus.Shipped => "info",
                _ => "warning"
            };
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <small class="text-muted ms-2">@order.OrderedAt.ToString("dd MMM yyyy")</small>
                    </div>
                    <span class="badge bg-@statusClass">@statusText</span>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 mb-2">
                        @foreach (var item in order.Items.Take(3))
                        {
                            <img src="@item.ProductImageUrl" style="width:50px;height:50px;object-fit:cover;border-radius:6px"
                                 onerror="this.src='/images/no-image.png'" title="@item.ProductName" />
                        }
                        @if (order.Items.Count > 3)
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                 style="width:50px;height:50px;font-size:0.8rem">
                                +@(order.Items.Count - 3)
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Toplam: @order.TotalAmount.ToString("C2")</span>
                        <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                            Detay <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
