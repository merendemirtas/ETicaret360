@model ECommerceApp.Models.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = "Sipariş Detayı";
    var order = Model.Order;
}

<div class="container my-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="MyOrders" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <h1 class="fw-bold mb-0">Sipariş #@order.OrderNumber</h1>
        <span class="badge bg-@Model.StatusClass fs-6">@Model.StatusText</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Ürünler</h5>
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div class="d-flex gap-3">
                                <img src="@item.ProductImageUrl" style="width:60px;height:60px;object-fit:cover;border-radius:8px"
                                     onerror="this.src='/images/no-image.png'" />
                                <div>
                                    <div class="fw-semibold">@item.ProductName</div>
                                    <small class="text-muted">@item.UnitPrice.ToString("C2") x @item.Quantity</small>
                                </div>
                            </div>
                            <span class="fw-bold">@item.TotalPrice.ToString("C2")</span>
                        </div>
                    }
                    <div class="mt-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Ara Toplam</span><span>@order.SubTotal.ToString("C2")</span>
                        </div>
                        @if (order.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>İndirim</span><span>-@order.DiscountAmount.ToString("C2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-1">
                            <span>Kargo</span>
                            <span>@(order.ShippingCost == 0 ? "Ücretsiz" : order.ShippingCost.ToString("C2"))</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Toplam</span><span class="text-danger">@order.TotalAmount.ToString("C2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold">Teslimat Adresi</h6>
                    @if (order.Address is not null)
                    {
                        <p class="mb-0 small">@order.Address.FullName</p>
                        <p class="mb-0 small text-muted">@order.Address.Phone</p>
                        <p class="mb-0 small text-muted">@order.Address.District, @order.Address.City</p>
                        <p class="mb-0 small text-muted">@order.Address.FullAddress</p>
                    }
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold">Ödeme Bilgisi</h6>
                    @if (order.Payment is not null)
                    {
                        <p class="mb-1 small">Yöntem: @(order.Payment.Provider == "COD" ? "Kapıda Ödeme" : "Kredi/Banka Kartı")</p>
                        <p class="mb-0 small">Durum:
                            <span class="badge bg-@(order.Payment.Status == ECommerceApp.Models.Entities.PaymentStatus.Completed ? "success" : "warning")">
                                @order.Payment.Status
                            </span>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
